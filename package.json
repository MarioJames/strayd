{
  "name": "strayd-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "cargo build --release -p port-deck-cli",
    "pack:cli": "bun run build && bun scripts/stage-npm-package.ts && cd npm/strayd && bun pm pack --destination ../../dist/npm",
    "test": "cargo test --workspace",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
  }
}
