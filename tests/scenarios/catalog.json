      "id": "cross-user-stop-denied",
      "suite": "permissions",
      "requires": [
        "isolated-linux-container",
        "root-orchestrator",
        "tester-user"
      ],
      "launch": [
        "runuser",
        "-u",
        "tester",
        "--",
        "${strayd}",
        "--no-config",
        "stop",
        "resource",
        "--id",
        "${owned-id}",
        "--yes"
      ],
      "expected": "An unprivileged scanner cannot stop a root-owned process; the engine returns SignalDenied.",
      "sources": [
        "native-fixture"
      ]
