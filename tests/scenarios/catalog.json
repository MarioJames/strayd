{
  "schema_version": 1,
  "defaults": {
    "platforms": [
      "linux",
      "windows",
      "macos"
    ],
    "timeout_ms": 180000,
    "cwd": "unique scratch directory (home only for explicit home-directory cases)",
    "versions": "actual OS, artifact hash, runtime versions and image ID in each run report",
    "actions": [
      "scan-owned",
      "independent-cleanup"
    ],
    "assertions": "Rust support runner; literal expectations never obtained by calling the production naming function",
    "timeout_scope": "Outer suite deadline; readiness and actions have shorter Rust deadlines"
  },
  "cases": [
    {
      "id": "cfuse-home-proxy",
      "suite": "native",
      "requires": [
        "owned-process",
        "tcp"
      ],
      "launch": [
        "${fixture:cfuse}",
        "proxy",
        "--port",
        "9792"
      ],
      "expected": "Executable is cfuse despite the home working directory.",
      "sources": [
        "native-fixture",
        "synthetic"
      ]
    },
    {
